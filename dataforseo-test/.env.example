# ==============================================================================
# DataForSEO Credentials & Runtime Configuration
# Copy this file to `.env` and fill in your actual credentials.
# ==============================================================================

# DataForSEO Account Credentials (Login email & API password from dashboard)
# Accepts DATAFORSEO_LOGIN or DATAFORSEO_USERNAME
DATAFORSEO_LOGIN=your_login_email@domain.com
DATAFORSEO_PASSWORD=your_api_password_here

# Default Target Location & Language
# 2826 = United Kingdom, 2840 = United States, 2124 = Canada, 2036 = Australia
DATAFORSEO_DEFAULT_LOCATION_CODE=2826
DATAFORSEO_DEFAULT_LANGUAGE_CODE=en

# Safety Guardrails & Rogue Agent Protection
# Maximum cost in USD allowed per individual script/workflow run before hard abort
DATAFORSEO_MAX_BUDGET_USD_PER_RUN=0.25

# Hard limit on total API calls allowed per single execution
DATAFORSEO_MAX_CALLS_PER_RUN=6

# Local Caching (Saves money by avoiding duplicate API calls for same keyword within TTL)
DATAFORSEO_ENABLE_CACHE=true
DATAFORSEO_CACHE_TTL_HOURS=24

# Keywords Everywhere Credentials (for hybrid multi-source keyword expansion)
KEYWORDS_EVERYWHERE_API_KEY=your_ke_api_key_here
