# Environment Credentials for awwwards-studio-web
# COPY THIS FILE TO .env AND FILL IN YOUR ACTUAL CREDENTIALS

# Google AI Pro (Google Veo, Imagen 3, Gemini 2.0 / Pro)
GEMINI_API_KEY=your_gemini_api_key_here

# Fal.ai GPU Video Pipeline (Kling 1.5 HD, Luma Dream Machine Ray 2, Wan 2.1)
FAL_KEY=your_fal_key_here

# Replicate API (Alternative video model host)
REPLICATE_API_TOKEN=your_replicate_token_here

# Runway Gen-3 API (Alternative)
RUNWAY_API_SECRET=your_runway_secret_here

# Magnific AI (Upscaler & Generative Hallucination)
# Used for 8K texture enhancement, skyboxes, and video keyframes
MAGNIFIC_API_KEY=your_magnific_key_here

# Spend Guardrails & Caching
MAX_BUDGET_USD_PER_RUN=0.50
ENABLE_MOCK_FALLBACK=true
CACHE_TTL_HOURS=24
