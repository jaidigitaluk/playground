# ==============================================================================
# Master Playground Gitignore - Zero Secret Leakage Policy
# ==============================================================================

# Environment & Credentials (NEVER commit these)
.env
.env.*
!.env.example
*.key
*.pem
credentials.json
*token*.json
*secret*.json

# Python Virtual Environments & Cache
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Playground Project Caching & Local Logs
.cache/
*.cache
*.log
*.sqlite
*.db

# macOS & OS artifacts
.DS_Store
Thumbs.db
