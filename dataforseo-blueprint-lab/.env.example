# DataForSEO credentials (https://app.dataforseo.com/)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Spend caps (USD). Defaults shown; final limits are James's decision (plan question 4).
LAB_MAX_USD_PER_RUN=0.25
LAB_MAX_USD_PER_DAY=1.00
LAB_MAX_CALLS_PER_RUN=6

# Keywords Everywhere caps (credits). KE calls must declare cost; unknown fails closed.
LAB_MAX_KE_CREDITS_PER_RUN=50
LAB_MAX_KE_CREDITS_PER_DAY=200
# Set to 1 only with James's explicit go-ahead for an unmetered KE call.
# LAB_ALLOW_UNKNOWN_COST=1

# Cache
LAB_CACHE_TTL_HOURS=24
