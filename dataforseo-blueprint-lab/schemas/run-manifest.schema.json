{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run manifest",
  "type": "object",
  "required": ["run_id", "created_at", "stage", "status", "code", "evidence_files"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "stage": {"type": "string", "enum": ["pull"]},
    "status": {"type": "string", "enum": ["open", "completed", "failed"]},
    "code": {
      "type": "object",
      "required": ["git_commit", "python_version"],
      "properties": {
        "git_commit": {"type": ["string", "null"]},
        "python_version": {"type": "string"}
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": ["provider", "endpoint", "payload"],
      "properties": {
        "provider": {"type": "string"},
        "endpoint": {"type": "string"},
        "payload": {"type": "object"}
      },
      "additionalProperties": false
    },
    "evidence_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "cache_hit": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
